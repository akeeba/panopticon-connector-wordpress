msgid "Akeeba Panopticon connection information"
msgstr "Informações de ligação do Akeeba Panopticon"

msgid ""
"Allow Akeeba Panopticon to remotely install extensions on this site. Disable "
"this if you do not want to allow remote extension installation for security "
"reasons."
msgstr ""
"Permitir que o Akeeba Panopticon instale extensões remotamente neste site. "
"Desative esta opção se não quiser permitir a instalação remota de extensões "
"por motivos de segurança."

msgid "Allow Remote Extension Installation"
msgstr "Permitir a instalação remota de extensões"

msgid "Already up to date."
msgstr "Já está atualizado."

msgid "Another update is already running."
msgstr "Já está em curso outra atualização."

msgid "Checksums were not found. Please call the prepare endpoint first."
msgstr "Não foram encontradas somas de controlo. Chame primeiro o endpoint de preparação."

msgid ""
"Collect and report system information such as CPU usage and disk usage. This "
"is useful for troubleshooting server performance issues, but some hosts like "
"to pretend you are not allowed to collect it and may give you a hard time. "
"In this case, disable this feature until you move your site to a decent host."
msgstr ""
"Recolha e comunique informações do sistema, como a utilização do CPU e do "
"espaço em disco. Isto é útil para resolver problemas de desempenho do "
"servidor, mas alguns alojamentos fazem de conta que não lhe é permitido "
"recolhê-las e podem dificultar-lhe a vida. Nesse caso, desative esta "
"funcionalidade até mudar o seu site para um alojamento decente."

msgid "Connection information"
msgstr "Informações de ligação"

msgid "Could not determine whether the package is a plugin or a theme."
msgstr "Não foi possível determinar se o pacote é um plugin ou um tema."

msgid "Could not download checksums from %1$s (HTTP %2$d)."
msgstr "Não foi possível transferir as somas de controlo de %1$s (HTTP %2$d)."

msgid "Could not find update information for WordPress %s."
msgstr "Não foi possível encontrar informações de atualização para o WordPress %s."

msgid "Endpoint URL"
msgstr "URL do endpoint"

msgid "Failed to decompress the checksums file."
msgstr "Não foi possível descomprimir o ficheiro das somas de controlo."

msgid "Failed to download the package: %s"
msgstr "Não foi possível transferir o pacote: %s"

msgid "Failed to download the package: HTTP %d"
msgstr "Não foi possível transferir o pacote: HTTP %d"

msgid "Failed to parse the checksums JSON: %s"
msgstr "Não foi possível processar o JSON das somas de controlo: %s"

msgid "Failed to save the uploaded file."
msgstr "Não foi possível guardar o ficheiro carregado."

msgid "No"
msgstr "Não"

msgid "No file data was provided."
msgstr "Não foram fornecidos dados do ficheiro."

msgid "Panopticon"
msgstr "Panopticon"

msgid "Plugin installation failed."
msgstr "A instalação do plugin falhou."

msgid "Plugin installation failed: %s"
msgstr "A instalação do plugin falhou: %s"

msgid "Plugin not found."
msgstr "Plugin não encontrado."

msgid "Preferences"
msgstr "Preferências"

msgid "Remote extension installation is disabled on this site."
msgstr "A instalação remota de extensões está desativada neste site."

msgid "Report System Information"
msgstr "Comunicar informações do sistema"

msgid "Save Settings"
msgstr "Guardar definições"

msgid "Settings saved."
msgstr "Definições guardadas."

msgid "The URL parameter is required."
msgstr "O parâmetro URL é obrigatório."

msgid "The filename is invalid after sanitisation."
msgstr "O nome do ficheiro é inválido após a sanitização."

msgid "The filename parameter is required."
msgstr "O parâmetro do nome do ficheiro é obrigatório."

msgid "The plugin was installed and activated successfully."
msgstr "O plugin foi instalado e ativado com sucesso."

msgid "The plugin was installed but activation failed: %s"
msgstr "O plugin foi instalado, mas a ativação falhou: %s"

msgid "The plugin was installed but could not be located."
msgstr "O plugin foi instalado, mas não foi possível localizá-lo."

msgid "The provided URL is invalid."
msgstr "O URL fornecido é inválido."

msgid "The theme was installed and activated successfully."
msgstr "O tema foi instalado e ativado com sucesso."

msgid "The theme was installed but could not be located."
msgstr "O tema foi instalado, mas não foi possível localizá-lo."

msgid "Theme installation failed."
msgstr "A instalação do tema falhou."

msgid "Theme installation failed: %s"
msgstr "A instalação do tema falhou: %s"

msgid "Theme not found."
msgstr "Tema não encontrado."

msgid "There is no such update."
msgstr "Não existe essa atualização."

msgid "Token"
msgstr "Token"

msgid "Yes"
msgstr "Sim"

msgid "You must pass the session data."
msgstr "Tem de passar os dados da sessão."

msgid "You must provide an IP address."
msgstr "Tem de fornecer um endereço IP."

msgid ""
"Your site requires FTP credentials to install or update the WordPress core."
msgstr ""
"O seu site requer credenciais FTP para instalar ou atualizar o núcleo do "
"WordPress."

msgid "latest"
msgstr "última versão"
