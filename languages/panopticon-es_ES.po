msgid "Akeeba Panopticon connection information"
msgstr "Información de conexión de Akeeba Panopticon"

msgid ""
"Allow Akeeba Panopticon to remotely install extensions on this site. Disable "
"this if you do not want to allow remote extension installation for security "
"reasons."
msgstr ""
"Permitir a Akeeba Panopticon instalar extensiones de forma remota en este "
"sitio. Desactive esta opción si no desea permitir la instalación remota de "
"extensiones por motivos de seguridad."

msgid "Allow Remote Extension Installation"
msgstr "Permitir la instalación remota de extensiones"

msgid "Already up to date."
msgstr "Ya está actualizado."

msgid "Another update is already running."
msgstr "Ya hay otra actualización en curso."

msgid "Checksums were not found. Please call the prepare endpoint first."
msgstr "No se encontraron las sumas de verificación. Llame primero al endpoint de preparación."

msgid ""
"Collect and report system information such as CPU usage and disk usage. This "
"is useful for troubleshooting server performance issues, but some hosts like "
"to pretend you are not allowed to collect it and may give you a hard time. "
"In this case, disable this feature until you move your site to a decent host."
msgstr ""
"Recopile e informe información del sistema como el uso de CPU y de espacio "
"en disco. Esto es útil para diagnosticar problemas de rendimiento del "
"servidor, pero algunos proveedores de alojamiento fingen que no tiene "
"permiso para recopilarla y pueden ponerle trabas. En ese caso, desactive "
"esta función hasta que traslade su sitio a un alojamiento decente."

msgid "Connection information"
msgstr "Información de conexión"

msgid "Could not determine whether the package is a plugin or a theme."
msgstr "No se pudo determinar si el paquete es un plugin o un tema."

msgid "Could not download checksums from %1$s (HTTP %2$d)."
msgstr "No se pudieron descargar las sumas de verificación desde %1$s (HTTP %2$d)."

msgid "Could not find update information for WordPress %s."
msgstr "No se pudo encontrar información de actualización para WordPress %s."

msgid "Endpoint URL"
msgstr "URL del endpoint"

msgid "Failed to decompress the checksums file."
msgstr "No se pudo descomprimir el archivo de sumas de verificación."

msgid "Failed to download the package: %s"
msgstr "No se pudo descargar el paquete: %s"

msgid "Failed to download the package: HTTP %d"
msgstr "No se pudo descargar el paquete: HTTP %d"

msgid "Failed to parse the checksums JSON: %s"
msgstr "No se pudo analizar el JSON de sumas de verificación: %s"

msgid "Failed to save the uploaded file."
msgstr "No se pudo guardar el archivo subido."

msgid "No"
msgstr "No"

msgid "No file data was provided."
msgstr "No se proporcionaron datos de archivo."

msgid "Panopticon"
msgstr "Panopticon"

msgid "Plugin installation failed."
msgstr "La instalación del plugin ha fallado."

msgid "Plugin installation failed: %s"
msgstr "La instalación del plugin ha fallado: %s"

msgid "Plugin not found."
msgstr "Plugin no encontrado."

msgid "Preferences"
msgstr "Preferencias"

msgid "Remote extension installation is disabled on this site."
msgstr "La instalación remota de extensiones está desactivada en este sitio."

msgid "Report System Information"
msgstr "Informar información del sistema"

msgid "Save Settings"
msgstr "Guardar ajustes"

msgid "Settings saved."
msgstr "Ajustes guardados."

msgid "The URL parameter is required."
msgstr "El parámetro URL es obligatorio."

msgid "The filename is invalid after sanitisation."
msgstr "El nombre de archivo no es válido tras la limpieza."

msgid "The filename parameter is required."
msgstr "El parámetro de nombre de archivo es obligatorio."

msgid "The plugin was installed and activated successfully."
msgstr "El plugin se instaló y activó correctamente."

msgid "The plugin was installed but activation failed: %s"
msgstr "El plugin se instaló, pero la activación falló: %s"

msgid "The plugin was installed but could not be located."
msgstr "El plugin se instaló, pero no se pudo localizar."

msgid "The provided URL is invalid."
msgstr "La URL proporcionada no es válida."

msgid "The theme was installed and activated successfully."
msgstr "El tema se instaló y activó correctamente."

msgid "The theme was installed but could not be located."
msgstr "El tema se instaló, pero no se pudo localizar."

msgid "Theme installation failed."
msgstr "La instalación del tema ha fallado."

msgid "Theme installation failed: %s"
msgstr "La instalación del tema ha fallado: %s"

msgid "Theme not found."
msgstr "Tema no encontrado."

msgid "There is no such update."
msgstr "No existe esa actualización."

msgid "Token"
msgstr "Token"

msgid "Yes"
msgstr "Sí"

msgid "You must pass the session data."
msgstr "Debe proporcionar los datos de la sesión."

msgid "You must provide an IP address."
msgstr "Debe proporcionar una dirección IP."

msgid ""
"Your site requires FTP credentials to install or update the WordPress core."
msgstr ""
"Su sitio necesita credenciales FTP para instalar o actualizar el núcleo de "
"WordPress."

msgid "latest"
msgstr "última versión"
